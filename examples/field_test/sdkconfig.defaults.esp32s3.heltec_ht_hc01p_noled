#
# ESP32-S3 + Heltec HT-HC01P carrier field-test profile with LED output disabled.
#
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_MM_BCF_FILE="bcf_mf08551.mbin"
CONFIG_MM_FW_FILE="mm6108.mbin"
CONFIG_MM_RESET_N=1
CONFIG_MM_WAKE=2
CONFIG_MM_BUSY=5
CONFIG_MM_SPI_SCK=7
CONFIG_MM_SPI_MOSI=9
CONFIG_MM_SPI_MISO=8
CONFIG_MM_SPI_CS=4
CONFIG_MM_SPI_IRQ=3

CONFIG_FIELD_BUTTON_GPIO=0
CONFIG_FIELD_BUTTON_ACTIVE_LOW=y

CONFIG_FIELD_RGB_PWM_ENABLE=n
CONFIG_FIELD_RGB_ADDR_ENABLE=n
CONFIG_FIELD_RGB_ADDR_GPIO=48
CONFIG_FIELD_TRIGGER_AP_IP="192.168.50.1"
CONFIG_FIELD_TRIGGER_PORT=5010
CONFIG_FIELD_OUT_OF_RANGE_RSSI_DBM=-88
CONFIG_FIELD_STATUS_INTERVAL_MS=5000

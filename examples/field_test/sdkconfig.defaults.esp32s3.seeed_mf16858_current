#
# ESP32-S3 + Seeed XIAO HaLow Hat / WIO-WM6180 test profile.
#
# This uses the MF16858/FGH100M-H BCF from MM-IoT-SDK 2.10.4. Morse support
# confirmed that MF16858 is the Morse reference design name used for Quectel
# FGH100M-H-derived modules, but firmware and BCF versions must stay matched.
#
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_MM_BCF_FILE="bcf_mf16858.mbin"
CONFIG_MM_FW_FILE="mm6108.mbin"
CONFIG_MM_RESET_N=1
CONFIG_MM_WAKE=2
CONFIG_MM_BUSY=5
CONFIG_MM_SPI_SCK=7
CONFIG_MM_SPI_MOSI=9
CONFIG_MM_SPI_MISO=8
CONFIG_MM_SPI_CS=4
CONFIG_MM_SPI_IRQ=3

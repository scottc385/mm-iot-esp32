#
# ESP32-S3 + Seeed XIAO HaLow Hat / WIO-WM6180 test profile.
#
# This uses the Seeed-provided FGH100M-H US BCF referenced by Morse support:
# bcf_mf16858_us.mbin.
#
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_MM_BCF_FILE="bcf_mf16858_us.mbin"
CONFIG_MM_FW_FILE="mm6108_seeed_ac07cf.mbin"
CONFIG_MM_RESET_N=1
CONFIG_MM_WAKE=2
CONFIG_MM_BUSY=5
CONFIG_MM_SPI_SCK=7
CONFIG_MM_SPI_MOSI=9
CONFIG_MM_SPI_MISO=8
CONFIG_MM_SPI_CS=4
CONFIG_MM_SPI_IRQ=3

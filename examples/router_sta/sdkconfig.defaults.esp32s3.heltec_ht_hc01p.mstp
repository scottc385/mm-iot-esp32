#
# Proto-2 BACnet MS/TP router transport overlay.
#
# Use after the W5500 profile. This registers transport.mstp.0 as a real
# router service port on the RS485 bus; do not combine with the passive
# RS485 probe overlay.
#
CONFIG_ROUTER_STA_MSTP_ENABLE=y
CONFIG_ROUTER_STA_MSTP_PORT_ID=4
CONFIG_ROUTER_STA_MSTP_NET_AUTO=y
CONFIG_ROUTER_STA_MSTP_NET=50021
CONFIG_ROUTER_STA_MSTP_MAC=3
CONFIG_ROUTER_STA_MSTP_MAX_MASTER=127
CONFIG_ROUTER_STA_MSTP_MAX_INFO_FRAMES=4
CONFIG_ROUTER_STA_MSTP_UART_NUM=1
CONFIG_ROUTER_STA_MSTP_TX_GPIO=10
CONFIG_ROUTER_STA_MSTP_RX_GPIO=11
CONFIG_ROUTER_STA_MSTP_DE_GPIO=12
CONFIG_ROUTER_STA_MSTP_RE_N_GPIO=13
CONFIG_ROUTER_STA_MSTP_BAUD=38400
CONFIG_ROUTER_STA_MSTP_RX_STREAM_SIZE=4096
CONFIG_ROUTER_STA_MSTP_PDU_QUEUE_LEN=32
CONFIG_ROUTER_STA_MSTP_DRAIN_MAX=32
CONFIG_ROUTER_STA_MSTP_LOG_FRAMES=n
CONFIG_ROUTER_STA_MSTP_FSM_TASK_STACK_SIZE=4096
CONFIG_ROUTER_STA_MSTP_UART_TASK_STACK_SIZE=3072
CONFIG_ROUTER_STA_LOOP_DELAY_MS=5
CONFIG_ROUTER_STA_UDP_TBX_LOG_FRAMES=n
CONFIG_ROUTER_STA_W5500_BIP_LOG_FRAMES=n

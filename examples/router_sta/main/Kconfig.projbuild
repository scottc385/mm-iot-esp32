menu "HaLow router STA"

    config ROUTER_STA_UDP_LOCAL_PORT
        int "UDP/TBX local port"
        default 5000

    config ROUTER_STA_UDP_PEER_IP
        string "UDP/TBX peer IP"
        default "192.168.50.1"

    config ROUTER_STA_UDP_PEER_PORT
        int "UDP/TBX peer port"
        default 5000

    config ROUTER_STA_STATUS_INTERVAL_MS
        int "Status/heartbeat interval in milliseconds"
        default 5000

    config ROUTER_STA_TBX_ORIGIN_ID
        string "Router STA TBX origin ID"
        default "ESP1"
        help
            Four-byte origin ID included in TBX frames. Longer strings are
            truncated; shorter strings are zero padded.

    config ROUTER_STA_UDP_TBX_NET
        int "UDP/TBX transit network number"
        default 65000

    config ROUTER_STA_UDP_TBX_PORT_ID
        int "UDP/TBX router port ID"
        default 1

    config ROUTER_STA_DNET_TTL_MS
        int "Router learned DNET TTL in milliseconds"
        default 60000

    config ROUTER_STA_LOG_LEVEL
        int "Router service log level"
        default 1

    config ROUTER_STA_DEBUG_ROUTE_PROBE_DNET
        int "Debug route probe DNET"
        default 0
        help
            If non-zero, periodically send a debug NPDU using this DNET as the
            BACnet destination address after the UDP/TBX port has learned a
            matching peer route. This verifies the adapter learned-route
            transmit path before additional local transports are added.

endmenu

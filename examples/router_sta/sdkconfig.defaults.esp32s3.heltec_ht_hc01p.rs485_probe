#
# Optional Proto-2 RS485 hardware probe overlay.
#
# Add this after the W5500 profile while validating the RS485 transceiver
# wiring. This does not register MS/TP as a router port.
#
CONFIG_ROUTER_STA_RS485_PROBE_ENABLE=y
CONFIG_ROUTER_STA_RS485_UART_NUM=1
CONFIG_ROUTER_STA_RS485_TX_GPIO=10
CONFIG_ROUTER_STA_RS485_RX_GPIO=11
CONFIG_ROUTER_STA_RS485_DE_GPIO=12
CONFIG_ROUTER_STA_RS485_RE_N_GPIO=13
CONFIG_ROUTER_STA_RS485_BAUD=38400
CONFIG_ROUTER_STA_RS485_PROBE_INTERVAL_MS=0
CONFIG_ROUTER_STA_RS485_PROBE_LOG_FRAMES=n
CONFIG_ROUTER_STA_RS485_PROBE_SUMMARY_INTERVAL_MS=5000
